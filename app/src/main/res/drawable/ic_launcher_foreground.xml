<?xml version="1.0" encoding="utf-8"?>
<!--
    "Check north": a flat white check mark whose long stroke rises straight up into a north
    arrow, in thin square-ended strokes like the app's Metro glyphs. The stem stops at the
    arrowhead's point with a flat end so the two strokes meet in one clean tip. Kept inside the
    66dp safe zone so every launcher mask shows all of it. The 512 px Play Store icon is drawn
    from the same shapes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M38.06,56.06 L58,76 L58,32"
        android:strokeWidth="5.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <path
        android:pathData="M46,44 L58,32 L70,44"
        android:strokeWidth="5.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
</vector>
