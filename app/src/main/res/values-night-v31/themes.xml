<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ always shows a system splash screen; this one is just the window background
        with a transparent icon, so launch goes straight to home with no logo or branding.
    -->
    <style name="Theme.DueNorth" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
