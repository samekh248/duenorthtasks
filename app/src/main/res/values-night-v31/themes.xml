<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ splash screen: the animated check north on the magenta tile. The splash
        leaves as soon as the first frame is ready; nothing holds it for the animation.
    -->
    <style name="Theme.DueNorth" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_tile</item>
    </style>
</resources>
